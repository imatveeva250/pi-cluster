{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "kubernetes": {
    "managerFilePatterns": [
      "/\\.yaml$/"
    ]
  },
  "packageRules": [
    {
      "matchPackageNames": ["codeberg.org/forgejo/forgejo"],
      "allowedVersions": "/^15\\./"
    }
  ],
  "dependencyDashboard": true,
  "flux": {
    "managerFilePatterns": ["/\\.ya?ml$/"]
   }
}
